# Copy this file to .env.local and fill in real values:
#
#   cp .env.local.example .env.local      (copy — don't rename, keep this template)
#
# .env.local is gitignored; this template is not. Never put real secrets here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (free tier is fine).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# If connecting fails with an SSL/TLS error ("tlsv1 alert internal error"),
# that is almost never the code — Atlas rejects the TLS handshake for clients
# it won't serve. Check, in this order:
#   1. Atlas -> Network Access -> IP Access List: add your current IP.
#      (For a hackathon on shared/hotspot wifi, 0.0.0.0/0 saves a lot of pain.
#       Remove it afterwards.)
#   2. Atlas -> Database: a free M0 cluster auto-pauses after inactivity.
#      Resume it.
MONGODB_URI=
MONGODB_DB=vitaura

# Google AI Studio API key (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=

# Any long random string — used to sign admin login sessions (JWT).
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Gemini tuning (optional — sensible defaults, override only if needed)
# ---------------------------------------------------------------------------

# Model names are configurable because Gemini model IDs change over time.
# If you get a "model not found" error, check
# https://ai.google.dev/gemini-api/docs/models and update these.
#
# WATCH THE FREE-TIER DAILY CAP — THIS WILL BITE YOU.
#
# Every Gemini model on the free tier allows only 20 generateContent requests
# per day (quota id: GenerateRequestsPerDayPerProjectPerModel-FreeTier). That
# is not specific to one model: 2.5-flash and 2.5-flash-lite are both 20/day.
# Each claim check spends one, and a check that triggers an auto-FAQ draft
# spends two, so ~15 minutes of testing exhausts a model for the whole day.
#
# THE KEY DETAIL: the quota is PER MODEL ("PerProjectPerModel"). Exhausting
# one model does NOT block another — switching GEMINI_MODEL gives you a fresh
# 20 immediately. That is the fastest recovery when you run out mid-session.
#
# A 429 whose quota id contains "PerDay" is the daily cap, not a burst limit:
# waiting will not clear it (it resets at midnight US Pacific) and the app's
# retry/backoff cannot rescue it. Change model instead.
#
# Models confirmed working with this app's structured-output call:
#   gemini-3.1-flash-lite    ~1.1s   (current default)
#   gemini-flash-lite-latest ~1.1s
#   gemini-3-flash-preview   ~3.5s
#   gemini-flash-latest      ~3.7s
#   gemini-2.5-flash-lite    ~1.3s
#   gemini-2.5-flash         ~2.0s
# Retired — do not use: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-2.5-pro
#
# Check what a key can still use:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" #     https://generativelanguage.googleapis.com/v1beta/models
#
# Embeddings have a separate, far larger quota — they keep working when
# generation is exhausted, which is why /api/health probes with embedContent.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding vector size. 768 is a documented truncation point for
# gemini-embedding-001 (default 3072) and is ~4x cheaper to store and compare.
#
# WARNING: every embedding in the database must share this value — cosine
# similarity between different-length vectors is meaningless. If you change
# this after adding sources, go to /admin/sources and click "Re-embed all",
# or those sources become invisible to retrieval and every check silently
# comes back "unverified".
GEMINI_EMBEDDING_DIM=768

# Per-request timeout in ms. Requests are retried up to 3 times with
# exponential backoff on 429s and 5xx.
GEMINI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Auto-FAQ clustering (optional)
#
# Vitaura auto-publishes a public FAQ entry when a topic DOMINATES what people
# are asking: "5 of the 10 people who checked anything today asked about
# dengue". Two conditions, both required:
#
#   SHARE  the topic is >= this fraction of distinct people in the window
#   FLOOR  at least this many distinct people asked
#
# The floor exists because share alone is meaningless at low traffic — the
# first person to use the app is 100% of its users, and without a floor their
# single question would publish a public health FAQ off a sample of one.
#
# DEMO TIP: you will not have 10 strangers in the room. Set
# AUTO_FAQ_USER_THRESHOLD=2 and open two different browsers (each gets its own
# session id) — ask about dengue in both, and with 2 of 2 you are at 100%
# share and 2 people, so it publishes live on stage. Watch it appear on /faq
# and in the homepage trending feed.
# ---------------------------------------------------------------------------

AUTO_FAQ_SHARE_THRESHOLD=0.5
AUTO_FAQ_USER_THRESHOLD=5
AUTO_FAQ_WINDOW_HOURS=24

# Cosine similarity above which two claims count as "the same topic".
# Lower = more claims cluster together (more FAQs, less precise).
AUTO_FAQ_SIMILARITY_THRESHOLD=0.86
